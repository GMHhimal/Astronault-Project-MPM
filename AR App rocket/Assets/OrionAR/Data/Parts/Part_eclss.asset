  m_Name: Part_eclss
  m_EditorClassIdentifier: Assembly-CSharp::OrionAR.PartInfo
  partId: eclss
  displayName: Environmental Control and Life Support
  shortName: Life Support
  zone: 1
  order: 130
  keySpec: Regenerable amine swing bed
  summary: "The system that keeps the cabin breathable: it scrubs carbon dioxide,
    controls humidity and temperature, and maintains pressure.\n\nTwo amine beds
    alternate \u2014 one absorbs CO\u2082 and water vapour from the cabin while the
    other vents to space to release what it captured, then they swap."
  whyItMatters: "Nothing is consumed, unlike Apollo's lithium hydroxide canisters.
    That is what makes a 21-day mission possible in 8.95 m\xB3: there is simply no
    room to carry three weeks of expendable scrubbers."
  narration: {fileID: 0}
