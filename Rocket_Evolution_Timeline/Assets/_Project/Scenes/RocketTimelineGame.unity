  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RocketTimeline.UI.TriviaReviewPagerUI
  root: {fileID: 348080388}
  yearText: {fileID: 1424707852}
  nameText: {fileID: 1114511901}
